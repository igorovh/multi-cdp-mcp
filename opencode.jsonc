{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "multi-cdp": {
        "type": "local",
        "command": ["bun", "run", "src/index.ts"],
        "cwd": ".",
        "codemode": true,
        "protocol": "legacy",
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  }
}
